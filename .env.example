# SOS Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# REQUIRED - At least one model provider
# ============================================

# Google Gemini (recommended)
GEMINI_API_KEY=your-gemini-api-key

# Anthropic Claude (optional)
ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenAI (optional)
OPENAI_API_KEY=your-openai-api-key

# xAI Grok (optional)
XAI_API_KEY=your-xai-api-key

# ============================================
# OPTIONAL - Service Configuration
# ============================================

# Gateway URL
# GATEWAY_URL=https://gateway.example.com/

# Service ports
# SOS_ENGINE_PORT=6060
# SOS_MEMORY_PORT=7070
# SOS_ECONOMY_PORT=6062
# SOS_TOOLS_PORT=6063
# SOS_IDENTITY_PORT=6064

# ============================================
# REQUIRED for the Squad service — system-tier auth
# ============================================

# Bearer token that authenticates as the SYSTEM identity (is_system=True,
# unrestricted cross-tenant access) against the Squad service. Used by
# /auth/verify, /auth/revoke, /api-keys, and the auth CLI's revoke path.
#
# unset = system tier DISABLED (fail closed). Do not leave this blank in
# any deployed environment — sos/services/squad/auth.py only grants
# system-tier access when this var is both set AND matched via a
# constant-time compare; an unset var used to be silently treated as an
# empty-string token that matched an empty/no Authorization header (P0-A,
# sos-205-47f5f8c2 gate-3). Generate with e.g. `openssl rand -hex 32`.
SOS_SYSTEM_TOKEN=

# ============================================
# OPTIONAL - Agent Configuration
# ============================================

# Default agent
# SOS_AGENT_ID=agent:River
# SOS_AGENT_NAME=River

# Autonomy settings (seconds)
# SOS_PULSE_INTERVAL=300
# SOS_DREAM_INTERVAL=3600
# SOS_ENABLE_DREAMS=true
# SOS_ENABLE_AVATAR=false
# SOS_ENABLE_SOCIAL=false

# ============================================
# OPTIONAL - Storage Backend
# ============================================

# Memory backend: "local" or "cloudflare"
# SOS_MEMORY_BACKEND=local

# Cloudflare credentials (if using cloudflare backend)
# CLOUDFLARE_ACCOUNT_ID=your-account-id
# CLOUDFLARE_API_TOKEN=your-api-token
# CLOUDFLARE_D1_DATABASE_ID=your-d1-id
# CLOUDFLARE_VECTORIZE_INDEX=your-vectorize-index

# Redis (optional, for caching)
# SOS_REDIS_URL=redis://localhost:6379

# ============================================
# OPTIONAL - Observability
# ============================================

# Log level: DEBUG, INFO, WARNING, ERROR
# SOS_LOG_LEVEL=INFO

# Telemetry (disabled by default)
# SOS_TELEMETRY_ENABLED=false

# Sprint telemetry paths
# SOS_HOME=/opt/sos
# SOS_SITE_REPO=/opt/site
# SOS_MIRROR_REPO=/opt/mirror
# SOS_CURRENT_SPRINT_FILE=/opt/sos/.current_sprint

# Dashboard/auth
# SOS_DASHBOARD_COOKIE_NAME=sos_dash
# SOS_BUS_TOKENS_PATH=/home/sos/.sos/tokens.json
# SOS_APP_DB_ROLE=sos_app_role

# Telegram / Discord adapters
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# TELEGRAM_ALLOWED_USERS=12345,67890
# TELEGRAM_WEB_APP_URL=https://your-web-app.example.com
# TELEGRAM_ADMIN_CHAT_ID=123456789
# DISCORD_BOT_TOKEN=your-discord-bot-token
# DISCORD_WEB_APP_URL=https://your-web-app.example.com
# DISCORD_WEBHOOKS_PATH=/home/sos/.sos/discord_webhooks.json

# ============================================
# OPTIONAL - Voice (ElevenLabs)
# ============================================

# ELEVENLABS_API_KEY=your-elevenlabs-key
# ELEVENLABS_VOICE_ID=your-voice-id
