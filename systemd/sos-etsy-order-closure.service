[Unit]
Description=SOS Etsy Order Closure - hosted asset delivery
After=network.target redis-server.service sos-etsy-asset-forge.service

[Service]
Type=simple
User=mumega
Group=mumega
WorkingDirectory=/home/sos/SOS
Environment=PYTHONPATH=/home/sos/SOS
EnvironmentFile=-/home/sos/.env.secrets
EnvironmentFile=-/home/sos/SOS/.env
ExecStart=/usr/bin/python3 -m sos.services.etsy.order_closure --watch
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sos-etsy-order-closure

[Install]
WantedBy=multi-user.target
