[Unit]
Description=SOS Etsy Fulfillment Bridge - paid order nutrient sensor
After=network.target redis-server.service

[Service]
Type=simple
User=mumega
Group=mumega
WorkingDirectory=/home/sos/SOS
Environment=PYTHONPATH=/home/sos/SOS
EnvironmentFile=-/home/sos/.env.secrets
EnvironmentFile=-/home/sos/SOS/.env
ExecStart=/usr/bin/python3 -m sos.services.etsy.fulfillment_bridge --watch
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sos-etsy-fulfillment-bridge

[Install]
WantedBy=multi-user.target

