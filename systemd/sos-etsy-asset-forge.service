[Unit]
Description=SOS Etsy Asset Forge - personalized digital fulfillment
After=network.target redis-server.service sos-etsy-fulfillment-bridge.service

[Service]
Type=simple
User=mumega
Group=mumega
WorkingDirectory=/home/sos/SOS
Environment=PYTHONPATH=/home/sos/SOS
EnvironmentFile=-/home/sos/.env.secrets
EnvironmentFile=-/home/sos/SOS/.env
ExecStart=/usr/bin/python3 -m sos.services.etsy.asset_forge --watch
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sos-etsy-asset-forge

[Install]
WantedBy=multi-user.target
